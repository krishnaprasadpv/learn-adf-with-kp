{
	"name": "EmployeesParquet",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ParquetStorage",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"EmployeesParquetFileName": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@{concat(dataset().EmployeesParquetFileName,'.parquet')}",
					"type": "Expression"
				},
				"fileSystem": "reporting"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}
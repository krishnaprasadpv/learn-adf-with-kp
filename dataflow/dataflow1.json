{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ReportingSourceCSV",
						"type": "DatasetReference"
					},
					"name": "ReportingCSVSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "CSV_Destination_2",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "splitVisa"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "PaymnetNullsAsNA"
				}
			],
			"scriptLines": [
				"parameters{",
				"     FileName as string (\"Testing\")",
				"}",
				"source(output(",
				"          transaction_id as string,",
				"          transactional_date as string,",
				"          product_id as string,",
				"          customer_id as string,",
				"          payment as string,",
				"          credit_card as string,",
				"          loyalty_card as string,",
				"          cost as string,",
				"          quantity as string,",
				"          price as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ReportingCSVSource",
				"ReportingCSVSource select(mapColumn(",
				"          transaction_id,",
				"          transactional_date,",
				"          product_id,",
				"          customer_id,",
				"          payment,",
				"          credit_card,",
				"          loyalty_card,",
				"          cost,",
				"          quantity,",
				"          price",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 filter(customer_id!='12') ~> filter1",
				"filter1 split(payment=='visa',",
				"     payment=='mastercard',",
				"     disjoint: false) ~> splitVisa@(visa, mastercard, otherThanVisaAndMC)",
				"splitVisa@visa aggregate(groupBy(customer_id),",
				"     max_product_id = max(product_id),",
				"          min_product_id = min(product_id)) ~> aggregate1",
				"splitVisa@otherThanVisaAndMC derive(payment = coalesce(payment,'N/A')) ~> PaymnetNullsAsNA",
				"PaymnetNullsAsNA sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          transaction_id as string,",
				"          transactional_date as string,",
				"          product_id as string,",
				"          customer_id as string,",
				"          payment as string,",
				"          credit_card as string,",
				"          loyalty_card as string,",
				"          cost as string,",
				"          quantity as string,",
				"          price as string",
				"     ),",
				"     partitionFileNames:[($FileName)],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1) ~> sink1"
			]
		}
	}
}